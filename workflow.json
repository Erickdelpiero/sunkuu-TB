{
  "name": "Monitor Reporte Mensual Sunkuu",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 1 * *"
            }
          ]
        }
      },
      "id": "1",
      "name": "Cron Mensual 8:30am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "resource": "command",
        "operation": "execute",
        "command": "docker logs gonex-tb-web-report --since 2h"
      },
      "id": "2",
      "name": "Leer Logs Reporte",
      "type": "n8n-nodes-base.ssh",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "sshPassword": {
          "id": "",
          "name": "SSH VPS-Solo lectura reportes"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ ($json.stdout.match(/ERROR/g) || []).length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "c2",
              "leftValue": "={{ ($json.stdout.match(/Dashboard report generated/g) || []).length }}",
              "rightValue": 4,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "or"
        },
        "options": {}
      },
      "id": "3",
      "name": "IF - Hubo error",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "chatId": "8398733157",
        "text": "=⚠️ Reporte mensual Sunkuu 360 con problemas.\n\nRevisar: docker logs gonex-tb-web-report --tail 50\n\nFecha: {{ $now.format('yyyy-MM-dd HH:mm') }}",
        "additionalFields": {}
      },
      "id": "4",
      "name": "Alertar Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [900, 220],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "Gonex Telegram Bot"
        }
      }
    }
  ],
  "connections": {
    "Cron Mensual 8:30am": {
      "main": [[{ "node": "Leer Logs Reporte", "type": "main", "index": 0 }]]
    },
    "Leer Logs Reporte": {
      "main": [[{ "node": "IF - Hubo error", "type": "main", "index": 0 }]]
    },
    "IF - Hubo error": {
      "main": [
        [{ "node": "Alertar Telegram", "type": "main", "index": 0 }],
        []
      ]
    }
  }
}